<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Scoped to this subtree only (dotnet/NuGet discovers the nearest NuGet.Config
    walking up from the project directory). The machine-wide NuGet.Config has an
    internal, VPN-only package source configured that isn't needed here and isn't
    reachable in this environment, so <clear/> resets to just nuget.org for
    restoring these two prototype projects.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
